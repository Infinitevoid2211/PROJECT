# BHU-RAKSHAK AI — Backend Configuration Template
PORT=8000
CORS_ORIGINS=*
DB_NAME=bhu_rakshak

# MongoDB connection (optional - falls back to resilient in-memory datastore if omitted)
MONGO_URL=mongodb://localhost:27017

# ==============================================================================
# Google Gemma Model Integration (via Google Gemini API / Google AI Studio)
# ==============================================================================
# Add your Google Gemini API key to enable live Google Gemma inference
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Primary Google Gemma chat & disaster reasoning model
# Supported: gemma-2-27b-it, gemma-2-9b-it, gemma-4-31b-it, gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-2-27b-it

# Multimodal Google Gemma model for crack & fissure computer vision diagnostic
GEMMA_VISION_MODEL=gemma-3-27b-it

